# crawler/.env
POSTGRES_USER=crawler_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=crawler_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL برای استفاده در کد پایتون (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Shared directory mounted at the same path in orchestrator and all workers.
STORAGE_ROOT=storage
LEARN_MAX_NEW_TEMPLATES=20
LEARN_MAX_TEMPLATES=250
LEARN_JOB_TIMEOUT=21600
EXTRACTOR_JOB_TIMEOUT=300
SCRAPE_JOB_TIMEOUT=900
PENDING_JOB_TIMEOUT=86400
CLEANUP_INTERVAL_SECONDS=3600
ARTIFACT_RETENTION_SECONDS=86400
JOB_RETENTION_SECONDS=86400
TEMPORARY_RETENTION_SECONDS=86400
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=360
FINAL_VALIDATION_MAX_HTML_CHARS=100000
AUTH_STATE_FILE=app/auth/auth.json
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8000
LOG_LEVEL=INFO
