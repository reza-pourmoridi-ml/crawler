# crawler/.env
POSTGRES_USER=crawler_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=crawler_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL برای استفاده در کد پایتون (SQLAlchemy)
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Shared directory mounted at the same path in orchestrator and all workers.
STORAGE_ROOT=storage
LEARN_INTERVAL_SECONDS=604800
LEARN_RETRY_SECONDS=3600
LEARN_JOB_TIMEOUT=21600
EXTRACTOR_JOB_TIMEOUT=300
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TIMEOUT=360
FINAL_VALIDATION_MAX_HTML_CHARS=100000
