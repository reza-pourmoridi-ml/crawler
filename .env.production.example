# Copy to an untracked file and change all deployment-specific values.
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1

POSTGRES_DB=crawler
POSTGRES_USER=crawler
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql+psycopg://crawler:replace-with-a-long-url-safe-password@postgres:5432/crawler

CONTROL_PUBLISHED_PORT=8000
STORAGE_HOST_PATH=./storage
APP_UID=1000
APP_GID=1000
LOG_LEVEL=INFO
IMAGE_TAG=production
