# Local Docker profile: this model name is also the explicit model-pull target.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1

POSTGRES_DB=crawler
POSTGRES_USER=crawler
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://crawler:change-this-local-password@postgres:5432/crawler

CONTROL_PUBLISHED_PORT=8000
OLLAMA_PUBLISHED_PORT=11434
STORAGE_HOST_PATH=./storage
APP_UID=1000
APP_GID=1000
LOG_LEVEL=INFO
IMAGE_TAG=local
